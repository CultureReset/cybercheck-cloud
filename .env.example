# Everything the platform reads. Nothing else is configurable, and nothing
# below has a value compiled into the source.

DATABASE_URL=postgres://localhost/cybercheck_platform
PORT=4000

# The address this platform is reachable at. Apps are told this so they can
# load the SDK and call back; it is not inferred from a request header, which
# a caller controls.
PLATFORM_URL=http://localhost:4000

# The store new apps publish into by default.
DEFAULT_STORE_SLUG=official
DEFAULT_STORE_NAME=Official Store

# Session and app-token lifetimes, in seconds.
SESSION_TTL_SECONDS=2592000
ACCESS_TOKEN_TTL_SECONDS=900
HANDOFF_CODE_TTL_SECONDS=60
